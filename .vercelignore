# Local env files must never ship in deployments: Vercel project env vars are
# the source of truth (bun env:vercel:*), and frameworks like Next.js would
# otherwise load these localhost values at runtime. .env.schema carries no
# secrets (it's the type/shape declaration varlock's codegen needs at build
# time) and .env.example is a values-free reference, so both are exempted.
.env
.env.*
**/.env
**/.env.*
!**/.env.example
!**/.env.schema
local.db
local.db-*
.alchemy/

# Build artifacts are regenerated remotely by each service's buildCommand;
# shipping local ones (especially apps/web/.next) can blow past Vercel's
# upload size limit and are never what should run anyway.
.next/
**/.next/
dist/
**/dist/
!apps/server/dist/
!apps/server/dist/index.mjs
.turbo/
**/.turbo/
node_modules/
**/node_modules/
