{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "services": {
    "server": {
      "root": "apps/server",
      "framework": "elysia",
      "entrypoint": "dist/index.mjs",
      "buildCommand": "cd ../.. && bun run build --filter=server",
      "installCommand": "cd ../.. && bun install"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "server"
      }
    }
  ]
}
