{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "services": {
    "server": {
      "root": "apps/server",
      "framework": "elysia",
      "entrypoint": "dist/index.mjs",
      "buildCommand": "cd ../.. && bun run build --filter=server",
      "installCommand": "cd ../.. && bun install"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "cd ../.. && bun run build --filter=web",
      "installCommand": "cd ../.. && bun install"
    }
  },
  "rewrites": [
    {
      "source": "/rpc/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/api/auth/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/api-reference/(.*)",
      "destination": { "service": "server" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
