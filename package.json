{
  "name": "call-e-commonlot",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "varlock": "1.18.0",
      "@types/node": "^26.4.1",
      "@orpc/server": "^1.15.0",
      "@orpc/openapi": "^1.15.0",
      "@orpc/zod": "^1.15.0",
      "better-auth": "1.7.3",
      "evlog": "^2.28.1",
      "ai": "^7.0.93",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@orpc/client": "^1.15.0",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:down": "docker compose down postgres",
    "db:generate": "turbo run db:generate -F @call-e-commonlot/db --",
    "db:migrate": "turbo run db:migrate -F @call-e-commonlot/db --",
    "db:push": "turbo run db:push -F @call-e-commonlot/db --",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:studio": "turbo run db:studio -F @call-e-commonlot/db --",
    "db:watch": "docker compose up postgres",
    "deploy": "vercel deploy",
    "deploy:check": "vercel deploy --dry",
    "deploy:prod": "vercel deploy --prod",
    "deploy:setup": "vercel link",
    "dev": "turbo run dev",
    "dev:server": "turbo run dev -F server --",
    "dev:types": "tsc -b packages/api --watch",
    "dev:vercel": "vercel dev -L",
    "dev:web": "turbo run dev -F web --",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:up": "docker compose up -d --build",
    "down": "bash scripts/stop.sh",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "fix": "ultracite fix",
    "postinstall": "tsc -b packages/api && varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
    "logs": "bash scripts/logs.sh",
    "logs:ui": "docker compose up -d dozzle",
    "restart": "bash scripts/restart.sh",
    "status": "bash scripts/status.sh",
    "test": "turbo run test",
    "up": "bash scripts/start.sh"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@call-e-commonlot/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "lefthook": "latest",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.11.0",
    "varlock": "catalog:",
    "vercel": "^59.11.7"
  },
  "packageManager": "bun@1.3.14"
}
